rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function ownUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function targetUserDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function isValidRole(role) {
      return role in ['admin', 'editor', 'viewer'];
    }

    function householdRole(householdId) {
      return hasProfile() && userDoc().data.householdId == householdId
        ? userDoc().data.role
        : null;
    }

    function inHousehold(householdId) {
      return signedIn() && householdRole(householdId) != null;
    }

    function isAdmin(householdId) {
      return householdRole(householdId) == 'admin';
    }

    function canEdit(householdId) {
      return householdRole(householdId) in ['admin', 'editor'];
    }

    match /users/{userId} {
      allow read: if ownUser(userId)
        || (hasProfile()
          && userDoc().data.role == 'admin'
          && targetUserDoc(userId).data.householdId == userDoc().data.householdId);
      allow create: if hasProfile()
        && userDoc().data.role == 'admin'
        && request.resource.data.householdId == userDoc().data.householdId
        && isValidRole(request.resource.data.role);
      allow update: if hasProfile()
        && userDoc().data.role == 'admin'
        && resource.data.householdId == userDoc().data.householdId
        && request.resource.data.householdId == resource.data.householdId
        && isValidRole(request.resource.data.role);
      allow delete: if hasProfile()
        && userDoc().data.role == 'admin'
        && resource.data.householdId == userDoc().data.householdId;
    }

    match /households/{householdId} {
      allow read: if inHousehold(householdId);
      allow create, update, delete: if isAdmin(householdId);
    }

    match /households/{householdId}/{document=**} {
      allow read: if inHousehold(householdId);
      allow write: if canEdit(householdId);
    }
  }
}
