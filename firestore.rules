rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function householdRole(householdId) {
      return hasProfile() && userDoc().data.householdId == householdId
        ? userDoc().data.role
        : null;
    }

    function inHousehold(householdId) {
      return signedIn() && householdRole(householdId) != null;
    }

    function isAdmin(householdId) {
      return householdRole(householdId) == 'admin';
    }

    match /users/{userId} {
      allow read: if ownUser(userId);
      allow create: if ownUser(userId)
        && request.resource.data.role == 'member'
        && request.resource.data.householdId == null;
      allow update: if ownUser(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.householdId == resource.data.householdId;
    }

    match /households/{householdId} {
      allow read: if inHousehold(householdId);
      allow create, update, delete: if isAdmin(householdId);
    }

    match /households/{householdId}/{document=**} {
      allow read: if inHousehold(householdId);
      allow write: if isAdmin(householdId);
    }
  }
}
