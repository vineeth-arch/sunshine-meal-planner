rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The signed-in user's Firestore profile is the only trusted source for
    // household membership and role checks.
    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userHouseholdId() {
      return hasUserProfile() ? userProfile().data.householdId : null;
    }

    function userRole() {
      return hasUserProfile() ? userProfile().data.role : null;
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    function isEditor() {
      return userRole() == 'editor';
    }

    function isViewer() {
      return userRole() == 'viewer';
    }

    // Rules enforce household boundaries directly so client UI cannot bypass
    // access checks by pointing at another household's document path.
    function belongsToHousehold(householdId) {
      return hasUserProfile() && userHouseholdId() == householdId;
    }

    function canReadHousehold(householdId) {
      return belongsToHousehold(householdId) && (isAdmin() || isEditor() || isViewer());
    }

    function canWriteHouseholdData(householdId) {
      return belongsToHousehold(householdId) && (isAdmin() || isEditor());
    }

    function isValidRole(role) {
      return role in ['admin', 'editor', 'viewer'];
    }

    function targetUserProfile(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    match /users/{userId} {
      // Users can read their own profile; admins can manage profiles inside
      // their own household only.
      allow read: if signedIn() && request.auth.uid == userId
        || (isAdmin()
          && exists(/databases/$(database)/documents/users/$(userId))
          && targetUserProfile(userId).data.householdId == userHouseholdId());
      allow create: if isAdmin()
        && request.resource.data.householdId == userHouseholdId()
        && isValidRole(request.resource.data.role);
      allow update: if isAdmin()
        && resource.data.householdId == userHouseholdId()
        && request.resource.data.householdId == resource.data.householdId
        && isValidRole(request.resource.data.role);
      allow delete: if isAdmin()
        && resource.data.householdId == userHouseholdId();
    }

    match /households/{householdId} {
      allow read: if canReadHousehold(householdId);
      allow create, update, delete: if belongsToHousehold(householdId) && isAdmin();
    }

    match /households/{householdId}/dishes/{dishId} {
      allow read: if canReadHousehold(householdId);
      allow write: if canWriteHouseholdData(householdId);
    }

    match /households/{householdId}/ingredients/{ingredientId} {
      allow read: if canReadHousehold(householdId);
      allow write: if canWriteHouseholdData(householdId);
    }

    match /households/{householdId}/pantryItems/{itemId} {
      allow read: if canReadHousehold(householdId);
      allow write: if canWriteHouseholdData(householdId);
    }

    match /households/{householdId}/weeklyPlans/{planId} {
      allow read: if canReadHousehold(householdId);
      allow write: if canWriteHouseholdData(householdId);
    }

    // mealSlots are nested under weeklyPlans, so they need their own match.
    match /households/{householdId}/weeklyPlans/{planId}/mealSlots/{slotId} {
      allow read: if canReadHousehold(householdId);
      allow write: if canWriteHouseholdData(householdId);
    }

    // Household settings are readable across the household, but only admins
    // can change them.
    match /households/{householdId}/settings/{settingId} {
      allow read: if canReadHousehold(householdId);
      allow write: if belongsToHousehold(householdId) && isAdmin();
    }

    // Deny everything else by default, including unexpected collection paths.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
